{
  "name": "gym-bro-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc --project tsconfig.mobile.json && tsc --project tsconfig.node.json && tsc --project tsconfig.browser.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "mobile:sync": "npm run build && cap sync && npm run mobile:verify",
    "mobile:verify": "node scripts/verify-mobile.mjs",
    "mobile:assets": "capacitor-assets generate --ios --android --iconBackgroundColor \"#05070d\" --iconBackgroundColorDark \"#05070d\" --splashBackgroundColor \"#05070d\" --splashBackgroundColorDark \"#05070d\"",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3",
    "@mediapipe/tasks-vision": "0.10.35",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.5",
    "vitest": "^4.1.12"
  }
}
